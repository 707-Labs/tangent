    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@lucide/svelte": "^1.69.0",
